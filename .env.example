# Iron-session encryption (min 32 characters)
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# AWS IAM Identity Center (SSO) device login
AWS_SSO_START_URL=https://identitycenter.amazonaws.com/ssoins-XXXXXXXX
AWS_SSO_REGION=us-east-1

# Optional comma-separated allowlist of 12-digit AWS account IDs.
# Leave empty to allow every account assigned to the user.
AWS_ALLOWED_ACCOUNT_IDS=111122223333,444455556666

# Twilio per AWS account number (12 digits)
TWILIO_ACCOUNT_SID_111122223333=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN_111122223333=your_twilio_auth_token
# TWILIO_REGION_111122223333=us1
# TWILIO_EDGE_111122223333=ashburn
# TWILIO_PHONE_NUMBER_111122223333=+15551234567

# Dummy Account → Role → Project → Twilio Groups for local UI (no real secrets).
# Edit `.data/account-hierarchy.json` (seeded from `src/config/account-hierarchy.json`).
# Served by GET /api/account-hierarchy — swap the loader later for live AWS/Twilio data.
